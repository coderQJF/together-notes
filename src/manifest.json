{
  "name": "两个人的小记",
  "appid": "",
  "description": "备忘录与双人提醒",
  "versionName": "0.1.1",
  "versionCode": "11",
  "vueVersion": "3",
  "app-plus": {
    "usingComponents": true,
    "modules": {
      "Camera": {
        "description": "从系统相册选择图片附件"
      },
      "Share": {
        "description": "调用 Android 系统分享面板发送邀请码和公开分享链接"
      }
    },
    "screenOrientation": [
      "portrait-primary"
    ],
    "distribute": {
      "android": {
        "packagename": "cn.coderf.togethernotes",
        "enableOAID": false,
        "abiFilters": [
          "arm64-v8a",
          "armeabi-v7a"
        ],
        "permissionExternalStorage": {
          "request": "none"
        },
        "permissionPhoneState": {
          "request": "none"
        },
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>"
        ],
        "excludePermissions": [
          "<uses-permission android:name=\"android.permission.CAMERA\"/>"
        ]
      },
      "ios": {}
    }
  },
  "mp-weixin": {
    "appid": "wx17ba49fc142c1e40",
    "setting": {
      "urlCheck": true
    },
    "usingComponents": true
  },
  "h5": {
    "router": {
      "mode": "hash"
    }
  },
  "uniStatistics": {
    "enable": false
  }
}
