{
  "name": "两个人的小记",
  "appid": "__UNI__10E8CA8",
  "description": "备忘录与双人提醒",
  "versionName": "0.2.4",
  "versionCode": "24",
  "vueVersion": "3",
  "app-plus": {
    "usingComponents": true,
    "modules": {
      "Camera": {
        "description": "从系统相册选择图片附件"
      },
      "Share": {
        "description": "调用 Android 系统分享面板发送邀请码和公开分享链接"
      },
      "Invocation": {
        "description": "调用 Android 系统文件选择器导入本机 TXT 文件"
      }
    },
    "screenOrientation": [
      "portrait-primary"
    ],
    "distribute": {
      "android": {
        "packagename": "cn.coderf.togethernotes",
        "enableOAID": false,
        "abiFilters": [
          "arm64-v8a",
          "armeabi-v7a"
        ],
        "permissionExternalStorage": {
          "request": "none"
        },
        "permissionPhoneState": {
          "request": "none"
        },
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>"
        ],
        "excludePermissions": [
          "<uses-permission android:name=\"android.permission.CAMERA\"/>"
        ]
      },
      "ios": {},
      "icons": {
        "android": {
          "ldpi": "src/static/app-icons/app-icon-48.png",
          "mdpi": "src/static/app-icons/app-icon-48.png",
          "hdpi": "src/static/app-icons/app-icon-72.png",
          "xhdpi": "src/static/app-icons/app-icon-96.png",
          "xxhdpi": "src/static/app-icons/app-icon-144.png",
          "xxxhdpi": "src/static/app-icons/app-icon-192.png"
        }
      }
    }
  },
  "mp-weixin": {
    "appid": "wx17ba49fc142c1e40",
    "setting": {
      "urlCheck": true
    },
    "usingComponents": true
  },
  "h5": {
    "router": {
      "mode": "hash"
    }
  },
  "uniStatistics": {
    "enable": false
  }
}
