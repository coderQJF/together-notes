export type ScheduleLocalReminder = (
  id: string,
  title: string,
  content: string,
  triggerAt: number,
  repeat: string,
  route: string
) => boolean

export type ReminderIdAction = (id: string) => boolean
export type ReminderBooleanAction = () => boolean
export type ReminderRouteAction = () => string
export type ConfigureReminderSync = (apiBase: string, sessionToken: string) => boolean
