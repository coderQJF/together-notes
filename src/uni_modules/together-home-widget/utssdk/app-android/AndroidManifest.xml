<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="io.dcloud.uni_modules.together_home_widget">
  <application>
    <receiver
      android:name="uts.sdk.modules.togetherHomeWidget.TogetherNoteWidgetProvider"
      android:enabled="true"
      android:exported="false"
      android:label="@string/together_widget_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/together_note_widget_info" />
    </receiver>

    <activity
      android:name="uts.sdk.modules.togetherHomeWidget.TogetherNoteWidgetConfigureActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:label="@string/together_widget_choose_note"
      android:theme="@android:style/Theme.Material.Light.NoActionBar">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
      </intent-filter>
    </activity>

    <service
      android:name="uts.sdk.modules.togetherHomeWidget.TogetherWidgetImageService"
      android:exported="false"
      android:permission="android.permission.BIND_REMOTEVIEWS" />
  </application>
</manifest>
