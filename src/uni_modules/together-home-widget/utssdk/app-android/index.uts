import {
  HomeWidgetBooleanAction,
  HomeWidgetImageCacheAction,
  HomeWidgetImageLookupAction,
  HomeWidgetJsonAction,
  HomeWidgetRouteAction,
  HomeWidgetStringAction
} from '../interface.uts'

export const syncHomeWidgetNotes : HomeWidgetJsonAction = function (notesJson : string) : boolean {
  const context = UTSAndroid.getAppContext()
  if (context == null) return false
  return TogetherHomeWidgetNative.syncNotes(context, notesJson)
}

export const cachedHomeWidgetImage : HomeWidgetImageLookupAction = function (noteId : string, attachmentId : string) : string {
  const context = UTSAndroid.getAppContext()
  if (context == null) return ''
  return TogetherHomeWidgetNative.cachedImage(context, noteId, attachmentId)
}

export const cacheHomeWidgetImage : HomeWidgetImageCacheAction = function (noteId : string, attachmentId : string, imageBase64 : string) : string {
  const context = UTSAndroid.getAppContext()
  if (context == null) return ''
  return TogetherHomeWidgetNative.cacheImage(context, noteId, attachmentId, imageBase64)
}

export const clearHomeWidgetNotes : HomeWidgetBooleanAction = function () : boolean {
  const context = UTSAndroid.getAppContext()
  if (context == null) return false
  return TogetherHomeWidgetNative.clearNotes(context)
}

export const requestHomeWidgetPin : HomeWidgetBooleanAction = function () : boolean {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) return false
  return TogetherHomeWidgetNative.requestPin(activity)
}

export const isHomeWidgetPinSupported : HomeWidgetBooleanAction = function () : boolean {
  const context = UTSAndroid.getAppContext()
  if (context == null) return false
  return TogetherHomeWidgetNative.isPinSupported(context)
}

export const selectHomeWidgetNote : HomeWidgetStringAction = function (noteId : string) : boolean {
  const context = UTSAndroid.getAppContext()
  if (context == null) return false
  return TogetherHomeWidgetNative.selectNote(context, noteId)
}

export const consumeHomeWidgetRoute : HomeWidgetRouteAction = function () : string {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) return ''
  return TogetherHomeWidgetNative.consumeRoute(activity)
}
