<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/together_widget_background"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:outlineProvider="background"
  android:padding="18dp">

  <TextView
    android:id="@+id/together_widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:fontFamily="sans-serif-medium"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:text="@string/together_widget_preview_title"
    android:textColor="#3E382D"
    android:textSize="20sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/together_widget_body"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="7dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:fontFamily="sans"
    android:includeFontPadding="false"
    android:lineSpacingExtra="2dp"
    android:maxLines="5"
    android:text="@string/together_widget_preview_body"
    android:textColor="#6F6555"
    android:textSize="14sp" />

  <AdapterViewFlipper
    android:id="@+id/together_widget_images"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="7dp"
    android:layout_weight="1"
    android:autoStart="true"
    android:flipInterval="5000"
    android:inAnimation="@android:anim/fade_in"
    android:loopViews="true"
    android:outAnimation="@android:anim/fade_out"
    android:visibility="gone" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/together_widget_date"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:fontFamily="sans"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="@string/together_widget_preview_date"
      android:textColor="#786D5B"
      android:textSize="13sp" />

    <ImageView
      android:id="@+id/together_widget_pin"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:contentDescription="@string/together_widget_pinned"
      android:src="@drawable/together_widget_pin" />
  </LinearLayout>
</LinearLayout>
