[Unit]
Description=Together Notes web and API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=together-notes
Group=together-notes
WorkingDirectory=/opt/together-notes/current
EnvironmentFile=/opt/together-notes/shared/server.env
ExecStart=/opt/node-v24/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/together-notes

[Install]
WantedBy=multi-user.target
