{
  "name": "together-notes",
  "version": "0.2.7",
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "prebuild:mp-weixin": "node scripts/configure-wechat.mjs",
    "build:mp-weixin": "uni build -p mp-weixin",
    "prebuild:app": "node scripts/configure-app.mjs",
    "build:app": "uni build -p app",
    "prepare:android-beta": "node scripts/apply-android-beta-secrets.mjs",
    "package:android-beta": "node scripts/package-android-beta.mjs",
    "deploy:mp-weixin": "node scripts/upload-wechat.mjs",
    "preview:mp-weixin": "node scripts/preview-wechat.mjs",
    "qa:icons": "node scripts/generate-ui-icons.mjs",
    "qa:mobile": "node scripts/capture-mobile.mjs",
    "type-check": "vue-tsc --noEmit",
    "server": "node --env-file-if-exists=server/.env server/index.mjs",
    "vip": "node --env-file-if-exists=server/.env server/manage-vip.mjs",
    "backup": "node --env-file-if-exists=server/.env server/backup.mjs",
    "test": "node --test server/test.mjs server/content.test.mjs server/ai-search.test.mjs server/ai-route.test.mjs server/wechat-reminders.test.mjs test/reader.test.mts test/local-reminder-rules.test.mts test/home-widget-rules.test.mts test/ui-contract.test.mts"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5020420260813003",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/uni-uts-v1": "^3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.1.3",
    "typescript": "^4.9.4",
    "vite": "5.2.8",
    "vue-tsc": "^1.0.24",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=24"
  }
